# ===== إعدادات ميتا / واتساب (انسخ هذا الملف إلى .env واملأ القيم) =====

# رقم هاتف واتساب للأعمال (Phone Number ID) من لوحة ميتا
PHONE_NUMBER_ID=

# معرّف حساب واتساب للأعمال (WhatsApp Business Account ID)
WABA_ID=

# رمز الوصول الدائم (System User Access Token) من Meta Business
WHATSAPP_TOKEN=

# كلمة سر تختارها بنفسك للتحقق من الـ Webhook (تكتبها هنا وفي إعدادات الـ Webhook في ميتا)
VERIFY_TOKEN=changeme-verify-token

# إصدار Graph API (اختياري)
GRAPH_VERSION=v21.0

# منفذ الخادم (اختياري)
PORT=3000
